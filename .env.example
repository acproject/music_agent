# ===== HTTP 网关（Rust api）=====
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
RUST_LOG=info,music_api=debug,music_analysis_client=debug

# ===== Python 音乐分析引擎 gRPC =====
ANALYSIS_GRPC_URL=http://127.0.0.1:50051
ANALYSIS_TIMEOUT_MS=2000
ANALYSIS_MAX_RETRIES=2

# ===== LLM（OpenAI 兼容协议：OpenAI / Qwen DashScope / DeepSeek / vLLM / Ollama 均可）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# 可选：HTTP(S) 代理，留空则跟随系统环境变量
LLM_PROXY_URL=

# ===== 存储（SQLite 元数据 + 音频文件目录）=====
DATABASE_URL=sqlite://data/music.db?mode=rwc
AUDIO_DIR=data/audio

# ===== Python 分析服务 =====
ANALYSIS_GRPC_PORT=50051
