# ===== HTTP 网关（Rust api）=====
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
RUST_LOG=info,music_api=debug,music_analysis_client=debug

# ===== Python 音乐分析引擎 gRPC =====
ANALYSIS_GRPC_URL=http://127.0.0.1:50051
ANALYSIS_TIMEOUT_MS=2000
ANALYSIS_MAX_RETRIES=2

# ===== LLM（OpenAI 兼容协议：OpenAI / Qwen DashScope / DeepSeek / vLLM / Ollama 均可）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# 可选：HTTP(S) 代理，留空则跟随系统环境变量
LLM_PROXY_URL=

# ===== 存储（SQLite 元数据 + 音频文件目录）=====
DATABASE_URL=sqlite://data/music.db?mode=rwc
AUDIO_DIR=data/audio

# ===== Python 分析服务 =====
ANALYSIS_GRPC_PORT=50051

# 离线 AnalyzeAudio 音高后端：yin（纯 numpy，默认）| crepe（本地 ONNX 高质量 f0）
# 实时 WebSocket 音高始终使用 YIN，与此开关无关。
# 启用 crepe 前先下载权重：python scripts/download_model.py --models tiny
PITCH_BACKEND=yin
# CREPE 模型规格：tiny | small | medium | large | full
CREPE_MODEL=tiny
# 权重目录，留空使用仓库根 models/crepe；下载源可用 HF_ENDPOINT 切换镜像
#CREPE_MODEL_DIR=
#CREPE_MIN_CONFIDENCE=0.5
